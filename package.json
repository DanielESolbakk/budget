{
  "name": "budget-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first budget planner scaffold",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage:signal": "vitest run --config vitest.unit.config.ts --coverage.enabled true",
    "test:mutation:signal": "stryker run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:vitest": "vitest run --config vitest.e2e.config.ts",
    "pretest:e2e:playwright": "npm run build",
    "test:e2e:playwright": "playwright test",
    "test:e2e": "npm run test:e2e:vitest",
    "deps:audit:signal": "tsx scripts/check-dependency-governance.ts --fail-on high",
    "ai:feedback:signal": "tsx scripts/ai-failure-feedback-loop.ts",
    "ai:skills:prune:signal": "tsx scripts/ai-skill-pruning-loop.ts",
    "ai:risk:checkpoint:signal": "tsx scripts/high-risk-judgment-checkpoint.ts",
    "verify:no-network": "vitest run --config vitest.nonetwork.config.ts",
    "benchmark:backup-restore": "tsx scripts/run-backup-restore-benchmark.ts",
    "validate:packaged-runtime": "tsx scripts/validate-packaged-runtime.ts",
    "sanitizer": "tsx scripts/sanitize-csv.ts",
    "verify-fixture": "tsx scripts/verify-fixture.ts",
    "eval:skill": "tsx scripts/run-skill-evals.ts",
    "postinstall": "node scripts/postinstall-electron.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/eslint-plugin": "^1.1.44",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
